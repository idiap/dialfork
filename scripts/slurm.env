# Shared by the *.sbatch scripts, which run the same way with sbatch (Slurm) or with
# bash (locally). See docs/reproducing.md.
#
# By default, commands run in the Python environment that is active when you
# submit or run them (conda, venv, ...): `pip install -r requirements.txt` there.
#
# Optional: run them inside an Apptainer image instead, e.g. the sdialog image,
# which has everything installed, Ollama included:
#   wget https://huggingface.co/datasets/sdialog/apptainer/resolve/main/sdialog.sif
#   export DIALFORK_SIF=$PWD/sdialog.sif
#
# Standard variables such as HF_TOKEN, HF_HOME or OLLAMA_MODELS are passed on as they
# are, also into the container: set them in your shell if you need them.

DIALFORK_SIF="${DIALFORK_SIF:-}"      # Apptainer image; empty = no container
DIALFORK_BIND="${DIALFORK_BIND:-}"    # extra folders the container must see, comma-separated

# run a command, inside the image when DIALFORK_SIF is set
run() {
    if [ -n "$DIALFORK_SIF" ]; then
        apptainer exec --nv ${DIALFORK_BIND:+--bind "$DIALFORK_BIND"} "$DIALFORK_SIF" "$@"
    else
        "$@"
    fi
}

# start an Ollama server for this job, on a free port of its own (several jobs can share
# a node), and stop it when the job ends
start_ollama() {
    export OLLAMA_LOAD_TIMEOUT="${OLLAMA_LOAD_TIMEOUT:-20m}"   # big models load slowly from network storage
    local port try
    for try in 1 2 3 4 5; do
        port=$(( 12000 + (RANDOM * 32768 + RANDOM) % 50000 ))
        # a port that answers is taken: a server there would fail to bind, and the job
        # would silently talk to another job's server
        if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
            continue
        fi
        export OLLAMA_HOST="127.0.0.1:$port"
        echo "Starting Ollama on $OLLAMA_HOST"
        # started directly (not through run): $! must be the server itself, to stop it at exit
        if [ -n "$DIALFORK_SIF" ]; then
            apptainer exec --nv ${DIALFORK_BIND:+--bind "$DIALFORK_BIND"} "$DIALFORK_SIF" ollama serve &
        else
            ollama serve &
        fi
        OLLAMA_PID=$!
        sleep 10   # give the server time to start
        if kill -0 "$OLLAMA_PID" 2>/dev/null; then
            break
        fi
        echo "Ollama did not start on $OLLAMA_HOST, trying another port"
    done
    trap 'kill "$OLLAMA_PID" 2>/dev/null; wait "$OLLAMA_PID" 2>/dev/null' EXIT
}

unset DBUS_SESSION_BUS_ADDRESS
